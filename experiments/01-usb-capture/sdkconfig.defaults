CONFIG_IDF_TARGET="esp32s3"

# El USB-C del S3 Zero va a GPIO19/20, que usa el USB Host:
# la consola sale por UART0 (TX=GPIO43, RX=GPIO44) con un adaptador USB-UART.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# Soporte de hub externo (FE1.1S)
CONFIG_USB_HOST_HUBS_SUPPORTED=y
